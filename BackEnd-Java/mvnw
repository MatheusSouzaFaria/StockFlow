#!/bin/sh
set -eu
cd "$(dirname "$0")"
if command -v mvn >/dev/null 2>&1; then exec mvn "$@"; fi
version=3.9.11
root="$HOME/.m2/stockflow-tools"
home="$root/apache-maven-$version"
if [ ! -x "$home/bin/mvn" ]; then
  mkdir -p "$root"
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT
  url="https://archive.apache.org/dist/maven/maven-3/$version/binaries/apache-maven-$version-bin.tar.gz"
  curl -fsSL "$url" -o "$tmp/maven.tar.gz"
  curl -fsSL "$url.sha512" -o "$tmp/maven.sha512"
  expected=$(grep -Eo '[0-9a-fA-F]{128}' "$tmp/maven.sha512" | head -n 1 | tr 'A-F' 'a-f')
  actual=$(if command -v sha512sum >/dev/null; then sha512sum "$tmp/maven.tar.gz"; else shasum -a 512 "$tmp/maven.tar.gz"; fi | awk '{print $1}')
  [ "$expected" = "$actual" ] || { echo 'Checksum inválido'; exit 1; }
  tar -xzf "$tmp/maven.tar.gz" -C "$root"
  rm -rf "$tmp"; trap - EXIT
fi
exec "$home/bin/mvn" "$@"
